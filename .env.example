# --- Kênh Zalo -------------------------------------------------------------
# Token Zalo Bot Platform từ https://bot.zaloplatforms.com (để trống để tắt)
ZALO_BOT_TOKEN=

# Đặt 1 để bật kênh tài khoản cá nhân (không chính thức; nên dùng nick phụ)
ZALO_PERSONAL=0

# --- AI --------------------------------------------------------------------
# Chỉ cần điền khoá API bên dưới. Để trống MODELS thì bot tự dùng model RẺ NHẤT của mỗi nhà
# cung cấp có khoá (chọn từ danh sách model mà khoá đó dùng được), theo thứ tự:
# gemini, deepseek, qwen, openai, ollama. Model trước lỗi, hết hạn mức hoặc quá chậm thì bot tự
# chuyển sang model sau. Lúc khởi động, log in ra danh sách model đã chọn.
#
# Muốn tự quyết thì liệt kê trong MODELS, cách nhau bằng dấu phẩy, mỗi mục là một trong:
#   tên nhà cung cấp        -> model rẻ nhất của họ      ví dụ: deepseek
#   nhà-cung-cấp:tên-model  -> đúng model đó             ví dụ: openai:gpt-5-mini, ollama:qwen3:8b
#   tên model Gemini        -> model Gemini đó           ví dụ: gemini-flash-latest
# Ví dụ: MODELS=deepseek,gemini,openai:gpt-5-mini
MODELS=

# Gemini (https://aistudio.google.com/apikey). Ngoài việc trả lời, khoá này còn bật tìm kiếm
# vector cho tài liệu và tìm kiếm Google; thiếu nó thì bot chỉ tìm tài liệu theo từ khoá.
# Khoá miễn phí chỉ có khoảng 20 lượt trả lời/ngày cho mỗi model Flash.
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# DeepSeek (https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=
# Qwen qua Alibaba Cloud Model Studio. Mặc định dùng cụm quốc tế (Singapore); tài khoản
# Trung Quốc đại lục thì đặt QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=
# Ollama chạy trên máy này, không cần khoá. Model phải hỗ trợ "tools" (gọi công cụ).
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_TIMEOUT_SECONDS=180
# Dịch vụ khác tương thích OpenAI (OpenRouter, Groq, ...): tự đặt tên, ví dụ "openrouter", rồi
# khai báo OPENROUTER_BASE_URL và OPENROUTER_API_KEY, và dùng openrouter:<model> trong MODELS.
# Mọi nhà cung cấp đều nhận <TÊN>_BASE_URL và <TÊN>_TIMEOUT_SECONDS (mặc định 15 giây,
# Ollama 180 giây; quá hạn thì bot chuyển sang model kế tiếp).

# Mô tả ngắn về đơn vị và giọng điệu trả lời (tuỳ chọn)
# BOT_PERSONA=Cửa hàng Sao Mai, chuyên thiết bị gia dụng. Xưng "em", gọi khách là "anh/chị".

# --- Nội dung của bot ------------------------------------------------------
# Mọi thứ bạn tự soạn nằm trong một thư mục, theo bố cục cố định:
#   workspace/system-prompt.md   hướng dẫn hệ thống
#   workspace/procedures/        quy trình (mỗi quy trình một file)
#   workspace/knowledge/         tài liệu: .pdf .docx .xlsx .csv .txt .md
#   workspace/listings/          bảng hàng cho MCP server bất động sản
# WORKSPACE_DIR=workspace
# Nguồn từ địa chỉ web, dạng Tên=URL, cách nhau bằng dấu phẩy. Nhận: trang web thường (lấy phần
# chữ), file tại URL (.pdf .docx .xlsx .csv), Google Sheets và Google Docs chia sẻ "Bất kỳ ai có
# đường liên kết". URL phải truy cập được công khai, không cần đăng nhập.
# KNOWLEDGE_URLS=Bảng giá=https://docs.google.com/spreadsheets/d/xxxx/edit?gid=0,Giới thiệu=https://example.com/gioi-thieu
# KNOWLEDGE_REFRESH_MINUTES=10

# Google Drive (tuỳ chọn): lấy tài liệu từ các thư mục hoặc file trên Drive, kể cả file riêng tư.
# Chi tiết từng bước: xem README, mục "Google Drive". Chọn MỘT trong hai cách đăng nhập:
#
# Cách 1 (khuyên dùng) - service account: tải file khoá JSON từ Google Cloud về, đặt vào đường
# dẫn dưới đây, rồi chia sẻ thư mục Drive cho email của service account (quyền Người xem).
# GOOGLE_SERVICE_ACCOUNT_FILE=data/google-service-account.json
#
# Cách 2 - đăng nhập bằng tài khoản Google của bạn: tạo OAuth client loại "Desktop app",
# điền hai dòng dưới rồi chạy: npm run google-login
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Đường dẫn (hoặc ID) của thư mục/file trên Drive, cách nhau bằng dấu phẩy
# GOOGLE_DRIVE_FOLDERS=https://drive.google.com/drive/folders/xxxx

# --- Quản trị viên ---------------------------------------------------------
# Dạng kênh:ID, cách nhau bằng dấu phẩy. Nhắn /id cho bot để lấy ID của bạn.
# Người đầu tiên nhận câu hỏi bot chuyển lên; tất cả đều dùng được công cụ dành cho admin.
# ADMINS=bot:6ede9afa66b88fe6d6a9

# --- Nhóm và cộng đồng -----------------------------------------------------
# Số lần tối đa bot trả lời (có gọi model) trong MỖI nhóm mỗi giờ. Mọi tin nhóm vẫn được ghi nhật
# ký dù có trả lời hay không. Đặt 0 để bot chỉ lắng nghe trong nhóm.
# GROUP_REPLIES_PER_HOUR=30
# Số lần tối đa bot trả lời (có gọi model) cho MỖI người mỗi giờ, tính gộp chat riêng và nhóm,
# để một người nhắn liên tục không làm cạn hạn mức API của mọi người. Admin không bị giới hạn.
# Đặt 0 để bỏ giới hạn.
# USER_REPLIES_PER_HOUR=20

# --- Log -----------------------------------------------------------------
# Số ngày giữ log hoạt động (data/logs) và nhật ký tin nhắn (data/messages). Cũ hơn thì tự xoá.
# Đặt 0 để giữ mãi.
# LOG_RETENTION_DAYS=30

# --- Công cụ ---------------------------------------------------------------
# Ai được dùng tìm kiếm web và đọc trang web: all (mặc định), admin, hoặc off để tắt hẳn hai công cụ này.
# Tìm kiếm dùng Google qua Gemini nếu khoá Gemini đã bật thanh toán, không thì dùng DuckDuckGo.
# WEB_AUDIENCE=all
# File khai báo công cụ gọi API, không cần lập trình (xem tools.example.json)
# CUSTOM_TOOLS_FILE=tools.json
# File cấu hình MCP (xem mcp.example.json)
# MCP_CONFIG=mcp.json
